# ─── Enable HTTP/2 (requires mod_http2) ──────────────────────
<IfModule mod_http2.c>
    Protocols h2 h2c http/1.1
</IfModule>

DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect www to non-www (canonical domain)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ─── Block dangerous HTTP methods (TRACE/TRACK/DEBUG) ────────
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG)$ [NC]
    RewriteRule .* - [F,L]

    # ─── Block path traversal attempts ───────────────────────────
    RewriteCond %{THE_REQUEST} \.\./ [OR]
    RewriteCond %{REQUEST_URI} \.\./ [NC,OR]
    RewriteCond %{REQUEST_URI} %2e%2e [NC]
    RewriteRule .* - [F,L]

    # ─── Block all hidden files except .well-known ───────────────
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # ─── Block bot / vulnerability scanner paths ─────────────────
    RewriteCond %{REQUEST_URI} (wp-login|wp-admin|wp-content|wp-includes|xmlrpc\.php) [NC,OR]
    RewriteCond %{REQUEST_URI} (phpmyadmin|pma|adminer|myadmin) [NC,OR]
    RewriteCond %{REQUEST_URI} (cgi-bin|/bin/sh|/etc/passwd) [NC,OR]
    RewriteCond %{REQUEST_URI} (ReportServer|owa/auth|autodiscover|aspnet_client) [NC,OR]
    RewriteCond %{REQUEST_URI} (\.asp$|\.aspx$|\.jsp$|\.cgi$) [NC,OR]
    RewriteCond %{REQUEST_URI} (/manager/html|/solr|/jenkins|/actuator|/graphql) [NC,OR]
    RewriteCond %{REQUEST_URI} (/console|/setup|/install|/shell|/eval|/exec|/cmd) [NC]
    RewriteRule .* - [F,L]

    # ─── WebSocket Proxy for Laravel Reverb ──────────────────────
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^app/(.*) ws://127.0.0.1:8080/app/$1 [P,L]

    RewriteCond %{REQUEST_URI} ^/app/ [NC]
    RewriteRule ^app/(.*) http://127.0.0.1:8080/app/$1 [P,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Security Headers ────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — force HTTPS for 1 year (preload-ready)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Restrict referrer leakage
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Basic permissions policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' http://localhost:5173; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com http://localhost:5173; font-src 'self' https://fonts.gstatic.com http://localhost:5173 data:; img-src 'self' data: blob: https: http://localhost:5173; connect-src 'self' ws://localhost:8080 wss://localhost:8080 ws://localhost:5173 http://localhost:5173; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Long cache for Vite hashed assets (filenames change on rebuild)
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # No cache for HTML (SPA shell)
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ─── Deny access to sensitive files ──────────────────────────────
<FilesMatch "(^\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|vitest\.config\.js|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Correct MIME types for JS modules
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
</IfModule>

# ─── Gzip Compression ────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf
</IfModule>

# ─── Brotli Compression (if available) ───────────────────────────
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/xml text/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
