# ═══════════════════════════════════════════════════════════════
# Insurance 2026 — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in __CHANGE_ME__ values.
# For Docker deployments, also create .env.production.
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME=تأمينكم
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ── Database ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insurance2026
DB_USERNAME=root
DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Cache ────────────────────────────────────────────────────
CACHE_STORE=redis

# ── Queue ────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# ── Mail ─────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@insrtami.online"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting (Reverb WebSocket) ─────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=__CHANGE_ME__
REVERB_APP_KEY=__CHANGE_ME__
REVERB_APP_SECRET=__CHANGE_ME__
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS="*"

# Reverb internal publish settings (defaults to REVERB_HOST/PORT/SCHEME)
# REVERB_PUBLISH_HOST="${REVERB_HOST}"
# REVERB_PUBLISH_PORT="${REVERB_PORT}"
# REVERB_PUBLISH_SCHEME="${REVERB_SCHEME}"
# REVERB_MAX_REQUEST_SIZE=10000

# ── Services ─────────────────────────────────────────────────
IP_API_KEY=
GEO_RESTRICTION_ENABLED=false
ALLOWED_COUNTRIES=SA
ADMIN_ALLOWED_IPS=
STATUS_POLL_SECRET=__CHANGE_ME__
ADMIN_VERIFICATION_EMAIL=

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="${APP_URL}"

# ── Frontend (Vite — prefixed with VITE_) ────────────────────
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_AUDIT=false
VITE_MOJAZ_FEE=119
