# ═══════════════════════════════════════════════════════════════════
# Insurance 2026 — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in __CHANGE_ME__ values.
# For Docker production, see .env.production.
#
# ⚠️  Keys marked __CHANGE_ME__ MUST be replaced before use.
#     php artisan key:generate   → APP_KEY
# ═══════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
APP_NAME="Insurance 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ─── Logging ─────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insurance2026
DB_USERNAME=root
DB_PASSWORD=
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
MYSQL_ATTR_SSL_CA=

# ─── Redis ───────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=
REDIS_URL=
REDIS_USERNAME=
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# ─── Session ─────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=ins2026_session
SANCTUM_STATEFUL_DOMAINS=localhost:8000

# ─── Cache / Queue ───────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=ins2026_cache
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache

# ─── Broadcasting (Reverb WebSocket) ────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=__CHANGE_ME__
REVERB_APP_KEY=__CHANGE_ME__
REVERB_APP_SECRET=__CHANGE_ME__
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_ALLOWED_ORIGINS="*"

# ─── Mail ────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Geo Restriction ────────────────────────────────────────────
IP_API_KEY=
GEO_RESTRICTION_ENABLED=false
ALLOWED_COUNTRIES=SA
ADMIN_ALLOWED_IPS=127.0.0.1

# ─── Admin ───────────────────────────────────────────────────────
ADMIN_PASSWORD=__CHANGE_ME__
ADMIN_VERIFICATION_EMAIL=
STATUS_POLL_SECRET=__CHANGE_ME__

# ─── CORS ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8000

# ─── Frontend (Vite — prefixed with VITE_) ──────────────────────
# Vite inlines these at build time. Must be literal values.
VITE_APP_NAME="Insurance 2026"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_AUDIT=false
VITE_MOJAZ_FEE=119
