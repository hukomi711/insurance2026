import { calculateVAT, calculateMonthlyPrice } from '@/utils/pricing';
import logger from '@/utils/logger';
import {
    FIXED_COMPANY_PRICES,
    DEDUCTIBLE_INCREASE,
    ADDONS_PRICES,
} from '@/data/pricingConstants';

/**
 * محرك التسعير المبسط (نموذج ثابت 100%)
 *
 * الصيغة النهائية:
 *   finalPrice = companyBasePrice + deductibleIncrease + selectedAddonsTotal
 *
 * لا تُستخدم أي معاملات ديناميكية (vehicleValue, driverAge, إلخ)
 *
 * الاستخدام:
 *   const { calculateAllQuotes, calculatePremium } = usePricingEngine();
 */
export function usePricingEngine() {
    /**
     * حساب السعر السنوي لخطة واحدة
     *
     * @param {Object} plan - الخطة { id?, companyId, subType, deductible }
     * @param {Object} formData - { vehicle, driver, policy } (غير مستخدم في النموذج الثابت)
     * @param {Object} [overrides] - { deductible?, additionalCoverages? }
     * @returns {Object} { annualPrice, monthlyPrice, vatAmount, totalWithVAT, basePrice, factors }
     */
    function calculatePremium(plan, formData = {}, overrides = {}) {
        try {
            // 1️⃣ السعر الأساسي من الشركة
            const companyName = plan.companyName || '';
            const basePrice = FIXED_COMPANY_PRICES[companyName] ?? FIXED_COMPANY_PRICES['تري للتأمين'] ?? 499;

            // 2️⃣ زيادة التحمل (deductible)
            const effectiveDeductible = overrides.deductible ?? plan.deductible ?? 1000;
            const deductiblePrice = DEDUCTIBLE_INCREASE[effectiveDeductible] ?? 0;

            // 3️⃣ أسعار الإضافات المختارة
            let addonsPrice = 0;
            if (overrides.additionalCoverages && Array.isArray(overrides.additionalCoverages)) {
                addonsPrice = overrides.additionalCoverages.reduce((total, addonId) => {
                    const addonPrice = ADDONS_PRICES[addonId]?.price ?? 0;
                    return total + addonPrice;
                }, 0);
            }

            // 4️⃣ السعر النهائي = السعر الأساسي + التحمل + الإضافات
            const annualBeforeVAT = basePrice + deductiblePrice + addonsPrice;
            const annualPrice = Math.round(annualBeforeVAT);

            // 5️⃣ الحسابات الثانوية
            const monthlyPrice = Math.round(annualPrice / 12);
            const vatAmount = Math.round(annualPrice * 0.15); // 15% VAT
            const totalWithVAT = annualPrice + vatAmount;

            return {
                annualPrice,
                originalPrice: annualPrice,
                monthlyPrice,
                vatAmount,
                totalWithVAT,
                basePrice,
                pricingFactors: {
                    // جميع العوامل = 1.0 (ثابتة — لا توجد معاملات ديناميكية)
                    vehicle: 1.0,
                    driver: 1.0,
                    lifestyle: 1.0,
                    policy: 1.0,
                    company: 1.0,
                    ncd: 1.0,
                    coverage: 1.0,
                    deductibleIncrease: deductiblePrice,
                    addonsTotal: addonsPrice,
                    total: 1.0,
                },
                breakdown: {
                    basePrice,
                    deductibleIncrease: deductiblePrice,
                    addonsTotal: addonsPrice,
                },
            };
        } catch (error) {
            logger.error('[PricingEngine] calculatePremium failed:', error, {
                planId: plan?.id,
                companyName: plan?.companyName,
            });
            // Fallback: return minimal pricing
            const fallbackPrice = 499;
            return {
                annualPrice: fallbackPrice,
                originalPrice: fallbackPrice,
                monthlyPrice: Math.round(fallbackPrice / 12),
                vatAmount: Math.round(fallbackPrice * 0.15),
                totalWithVAT: fallbackPrice + Math.round(fallbackPrice * 0.15),
                basePrice: fallbackPrice,
                pricingFactors: {
                    vehicle: 1.0,
                    driver: 1.0,
                    lifestyle: 1.0,
                    policy: 1.0,
                    company: 1.0,
                    ncd: 1.0,
                    coverage: 1.0,
                    total: 1.0,
                },
                breakdown: {
                    basePrice: fallbackPrice,
                    deductibleIncrease: 0,
                    addonsTotal: 0,
                },
            };
        }
    }

    /**
     * حساب الأسعار لجميع الخطط
     *
     * @param {Array} plans - مصفوفة الخطط
     * @param {Object} formData - بيانات النموذج (غير مستخدمة)
     * @param {Object} [overrides] - تجاوزات عامة
     * @returns {Array} مصفوفة خطط مع أسعار محدّثة
     */
    function calculateAllQuotes(plans, formData = {}, overrides = {}) {
        return plans.map((plan) => {
            const pricing = calculatePremium(plan, formData, overrides);
            return {
                ...plan,
                annualPrice: pricing.annualPrice,
                originalPrice: pricing.originalPrice,
                monthlyPrice: pricing.monthlyPrice,
                basePrice: pricing.basePrice,
                pricingFactors: pricing.pricingFactors,
            };
        });
    }

    return {
        calculatePremium,
        calculateAllQuotes,
    };
}
