# ═══════════════════════════════════════════════════════════════
# NPM Configuration — Dependency Governance
# ═══════════════════════════════════════════════════════════════

# Enforce exact versions — prevent accidental drift via ^ or ~ ranges
save-exact=true

# Require lockfile — prevent npm install from modifying package-lock.json
# Dev usage: npm install still works, but CI must use npm ci
package-lock=true

# Fail on peer dependency conflicts instead of silently ignoring
strict-peer-deps=true


# Recommended engine enforcement (requires engines field in package.json)
engine-strict=true
