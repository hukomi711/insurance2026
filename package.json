{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "insurance2026",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.10.0"
    },
    "scripts": {
        "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
        "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
        "build:force": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --force",
        "preview": "vite preview",
        "lint": "eslint resources/js/ --ext .vue,.js",
        "lint:fix": "eslint resources/js/ --ext .vue,.js --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "budget": "node scripts/quality/check-bundle-size.cjs",
        "deps:health": "node scripts/quality/check-deps-health.cjs",
        "deps:outdated": "node scripts/quality/check-outdated.cjs",
        "loadtest:customer-page": "node scripts/quality/load-test-customer-page.mjs",
        "ci:check": "npm run test && npm run build && npm run budget && npm run deps:health"
    },
    "dependencies": {
        "@fontsource/noto-kufi-arabic": "^5.2.9",
        "@fontsource/roboto": "^5.2.9",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@internationalized/date": "^3.11.0",
        "axios": "1.19.0",
        "dompurify": "^3.3.3",
        "laravel-echo": "^2.3.0",
        "pinia": "^3.0.4",
        "pusher-js": "^8.4.0",
        "radix-vue": "^1.9.17",
        "vue": "^3.5.28",
        "vue-i18n": "^11.2.8",
        "vue-router": "^5.0.4",
        "vue-toastification": "^2.0.0-rc.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/unplugin-vue-i18n": "^11.0.7",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "eslint": "^10.0.2",
        "eslint-plugin-vue": "^10.11.0",
        "happy-dom": "^20.7.0",
        "laravel-vite-plugin": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.3",
        "vitest": "4.1.11"
    },
    "overrides": {
        "brace-expansion": "^5.0.6",
        "esbuild": "^0.28.1",
        "glob": "^10.4.5",
        "minimatch": "^10.2.4",
        "ws": "^8.20.1"
    }
}
