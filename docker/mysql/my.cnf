# ═══════════════════════════════════════════════════════════════════
# MariaDB Custom Config — Insurance 2026 Production
# VPS: 12 GB RAM • DB target memory: ~3-4 GB
# ═══════════════════════════════════════════════════════════════════

[mysqld]

# ── Character set ────────────────────────────────────────────────
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# ── Basic safety ─────────────────────────────────────────────────
skip-name-resolve
local_infile = 0

# ── InnoDB core ──────────────────────────────────────────────────
innodb_file_per_table = 1

# Balanced for 12GB VPS where DB gets ~3-4GB
innodb_buffer_pool_size = 3G

# Redo log
innodb_log_file_size = 256M

# Strong durability (full ACID). Use 2 only if losing last ~1s on OS crash is acceptable.
innodb_flush_log_at_trx_commit = 1

# Good for Linux/Docker with InnoDB
innodb_flush_method = O_DIRECT

# SSD/NVMe friendly defaults
innodb_io_capacity     = 1000
innodb_io_capacity_max = 3000

# ── Connections ──────────────────────────────────────────────────
max_connections      = 120
thread_cache_size    = 64
table_open_cache     = 2000
wait_timeout         = 300
interactive_timeout  = 300

# ── Per-connection buffers (conservative; these are per thread) ──
tmp_table_size       = 32M
max_heap_table_size  = 32M
join_buffer_size     = 1M
sort_buffer_size     = 1M
read_buffer_size     = 512K
read_rnd_buffer_size = 1M

# ── Packet / Laravel practical limit ─────────────────────────────
max_allowed_packet = 64M

# ── Slow query logging ───────────────────────────────────────────
# /var/lib/mysql is owned by the mysql user and persisted on the data volume,
# so the slow log survives container restarts without an extra bind mount.
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 2

# Disabled by default in production — flip ON only during diagnosis:
#   SET GLOBAL log_queries_not_using_indexes = 1;
log_queries_not_using_indexes = 0

# Only log slow queries that examined meaningful rows
min_examined_row_limit = 1000

[client]
default-character-set = utf8mb4
