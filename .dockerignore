# ── Version control ───────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Dependencies (rebuilt inside image) ──────────────────────
node_modules
vendor

# ── IDE / Editor ─────────────────────────────────────────────
.idea
.vscode
*.swp
*.swo
_ide_helper*.php
.phpstorm.meta.php

# ── Docker (prevent recursive copy) ─────────────────────────
docker-compose*.yml
Dockerfile
.dockerignore
docker/secrets/
docker/certbot/

# ── Environment ──────────────────────────────────────────────
.env
.env.*

# ── Tests / CI ───────────────────────────────────────────────
tests

# ── Stale caches (will be regenerated at runtime) ────────────
bootstrap/cache/*.php
phpunit.xml
.phpunit.result.cache
coverage

# ── Documentation ────────────────────────────────────────────
README.md
*.md
docs

# ── Build artefacts ──────────────────────────────────────────
public/build
public/hot
output/
storage/logs/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/cache/*

# ── Dev / CI-only files ──────────────────────────────────────
.editorconfig
.gitleaks.toml
.pre-commit-config.yaml
phpstan.neon
vitest.config.js
DEPLOYMENT.md
backups/
backup*.sql
*.sql
check_admin.php
check_db.php
clear_lockout*.php
reset_admin_password.php
get_2fa_code.php
test_login_simple.php
test-ws.js

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
