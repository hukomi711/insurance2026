# ═══════════════════════════════════════════════════════════════════
# Insurance 2026 — PRODUCTION Environment Template (Docker)
# ═══════════════════════════════════════════════════════════════════
# Copy to .env.production on the server and replace ALL CHANGE_ME values.
#
# Placeholder conventions:
#   lybankss.com     → real apex domain (configured for production)
#   www.lybankss.com → www subdomain
#   ${INS_DOMAIN}        → consumed by deploy.sh / nginx template
#   ${INS_SERVER_IP}     → consumed by deploy.sh
#   CHANGE_ME            → MUST be replaced before first boot
#
# Generation hints (run on a trusted machine):
#   APP_KEY            → docker run --rm insurance2026-app php artisan key:generate --show
#   REVERB_APP_ID/KEY  → openssl rand -hex 12
#   REVERB_APP_SECRET  → openssl rand -hex 32
#   STATUS_POLL_SECRET → openssl rand -hex 32
#   ADMIN_PASSWORD     → openssl rand -base64 24   (then hash via tinker if needed)
#   DB_PASSWORD        → openssl rand -hex 32      (also written to docker/secrets/db_password.txt)
# ═══════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
APP_NAME="Insurance 2026"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://lybankss.com
ASSET_URL=https://lybankss.com
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ─── Public Domain (used by nginx template + email/sitemap routes) ─
DOMAIN=lybankss.com
SUPPORT_EMAIL_DOMAIN=lybankss.com

# ─── Logging ─────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ─── Database (MariaDB inside Docker) ────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=insurance2026
DB_USERNAME=insurance
# DB_PASSWORD is injected from docker/secrets/db_password.txt by entrypoint.
# Mirror the same value here for artisan CLI consistency:
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

# ─── Redis (in-cluster service name) ─────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=ins2026_
REDIS_PERSISTENT=false

# ─── Cache / Queue ───────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=ins2026_cache
QUEUE_CONNECTION=redis
HORIZON_PREFIX=ins2026_horizon:
FILESYSTEM_DISK=local
REDIS_CACHE_CONNECTION=cache

# ─── Session ─────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.lybankss.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=ins2026_session

# ─── Sanctum (SPA auth) ──────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=lybankss.com,www.lybankss.com

# ─── CORS ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://lybankss.com,https://www.lybankss.com

# ─── Broadcasting (Reverb WebSocket) ─────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=lybankss.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_ALLOWED_ORIGINS=https://lybankss.com,https://www.lybankss.com,http://lybankss.com,http://www.lybankss.com
# Internal publish address used by PHP container → reverb container:
REVERB_PUBLISH_HOST=reverb
REVERB_PUBLISH_PORT=8080
REVERB_PUBLISH_SCHEME=http

# ─── Frontend (Vite — inlined at build time) ─────────────────────
VITE_APP_NAME="Insurance 2026"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=lybankss.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_QUOTE_DIAGNOSTICS=false
VITE_AUDIT=false
VITE_MOJAZ_FEE=119

# ─── Mail (configure your SMTP provider) ─────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=support@lexusforbon.it.com
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@lexusforbon.it.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Geo Restriction ─────────────────────────────────────────────
IP_API_KEY=CHANGE_ME
GEO_RESTRICTION_ENABLED=true
# Temporary: allow Snap Pixel verifier User-Agent to bypass geo redirect
# Disable after successful Pixel verification in Ads Manager.
SNAP_PIXEL_VERIFIER_BYPASS=false

# Emergency fallback: temporarily disable geo redirect for all traffic
# only during Snap Pixel verification, then set back to false immediately.
SNAP_PIXEL_VERIFIER_FORCE_ALLOW=false
ALLOWED_COUNTRIES=SA
# Comma-separated list of admin IPs allowed to access /admin from outside SA:
ADMIN_ALLOWED_IPS=${INS_SERVER_IP}

# ─── Admin / API Secrets ─────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME
ADMIN_VERIFICATION_EMAIL=support@lexusforbon.it.com
ADMIN_LOGIN_EMAIL_FALLBACK=false
STATUS_POLL_SECRET=CHANGE_ME

# ─── NexaFlow CMS API ────────────────────────────────────────────
NEXAFLOW_API_KEY=CHANGE_ME
NEXAFLOW_BASE_URL=https://api.nexaflow.xyz/api
NEXAFLOW_WEBSITE_ID=CHANGE_ME
NEXAFLOW_TIMEOUT=10
NEXAFLOW_AUTH_HEADER=x-api-key

# ─── Horizon (queue dashboard) ───────────────────────────────────
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# ─── Trusted Proxies (Cloudflare / load balancer) ────────────────
TRUSTED_PROXIES=*
